+
+
+def _u32(x):
+    return x & 0xFFFFFFFF
+
+
+def _pad32(n):
+    return (n + 31) // 32 * 32
+
+
+def _round_away(x):
+    return np.sign(x) * np.floor(np.abs(x) + 0.5)
+
+
+def _q(x, scale, dtype):
+    info = np.iinfo(dtype)
+    return np.clip(_round_away(np.asarray(x, dtype=np.float64) * scale), info.min, info.max).astype(dtype)
+
+
+def nnbin_layout(feature, W, L1, L2):
+    """(構造の文字列, 特徴変換のハッシュ, ネットワークのハッシュ)。"""
+    name, fh, plane, nk = YO_FEATURES[feature]
+    ft = _u32(fh ^ (2 * W))
+
+    def aff(prev, o):
+        return _u32((0xCC03DAE4 + o) ^ (prev >> 1) ^ _u32(prev << 31))
+    h = _u32(0xEC42E90D ^ (2 * W))
+    h = _u32(0x538D24C7 + aff(h, L1))
+    h = _u32(0x538D24C7 + aff(h, L2))
+    net = aff(h, 1)
+    n = 2 * W
+    st = f"InputSlice[{n}(0:{n})]"
+    st = f"AffineTransformSparseInput[{L1}<-{n}]({st})"
+    st = f"ClippedReLU[{L1}]({st})"
+    st = f"AffineTransform[{L2}<-{L1}]({st})"
+    st = f"ClippedReLU[{L2}]({st})"
+    st = f"AffineTransform[1<-{L2}]({st})"
+    return f"Features={name}[{plane * nk}->{W}x2],Network={st}", ft, net
+
+
+def nnbin_support(arch):
