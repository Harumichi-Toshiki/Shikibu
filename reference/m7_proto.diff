index 0000000..7216d25
--- /dev/null
+++ b/crates/shk_feat/src/halfk.rs
@@ -0,0 +1,209 @@
+//! HalfKP / HalfKA 系（やねうら王互換）と、玉の周りのブロック（RayPair-K）。プロトタイプ。
+
+use crate::position::Position;
+use crate::raypair;
+
+const BK: [u32; 14] = [0, 1, 2, 3, 4, 5, 7, u32::MAX, 4, 4, 4, 4, 6, 8];
+const HAND_BASE: [(u32, u32); 7] = [(1, 20), (39, 44), (49, 54), (59, 64), (69, 74), (79, 82), (85, 88)];
+const F_KING: u32 = 1548;
+const E_KING: u32 = 1629;
+
+#[derive(Clone, Copy)]
+struct Kind {
+    plane: u32,
+    nk: u32,
+    with_king: bool,
+    merge: bool,
+    mirror: bool,
+    factor: bool,
+}
+
+fn kind(version: u8) -> Option<Kind> {
+    let (plane, nk, with_king, merge, mirror) = match version {
+        2 | 3 => (1548, 81, false, false, false),
+        4 | 5 => (1710, 81, true, false, false),
+        6 | 7 => (1629, 81, true, true, false),
+        8 | 9 => (1710, 45, true, false, true),
+        10 | 11 => (1629, 45, true, true, true),
+        _ => return None,
+    };
+    Some(Kind { plane, nk, with_king, merge, mirror, factor: version % 2 == 1 })
+}
+
+pub fn num_features(version: u8) -> Result<u32, String> {
+    match version {
+        0 | 1 => raypair::num_features(version),
+        12 => Ok(15000 + 1392),
+        13 => Ok(115352 + 1392),
+        _ => {
+            let k = kind(version).ok_or_else(|| format!("未知の version: {version}"))?;
+            Ok(k.plane * k.nk + if k.factor { k.plane } else { 0 })
+        }
+    }
+}
+
+fn mir(sq: u32) -> u32 {
+    (8 - sq / 9) * 9 + sq % 9
+}
+
+fn halfk(pos: &Position, persp: u8, k: Kind, out: &mut Vec<u32>) -> Result<(), String> {
+    let mut bps: [u32; 40] = [0; 40];
+    let mut n = 0usize;
+    let mut ksq = u32::MAX;
+    for y in 0..9 {
+        for x in 0..9 {
+            if let Some(p) = pos.board[y][x] {
+                let ysq = ((8 - x) * 9 + y) as u32;
+                let vsq = if persp == 0 { ysq } else { 80 - ysq };
+                let mine = p.color == persp;
+                let bp = if p.pt == 7 {
+                    if mine {
+                        ksq = vsq;
+                    }
+                    if !k.with_king {
+                        continue;
+                    }
+                    (if mine { F_KING } else { E_KING }) + vsq
+                } else {
+                    let f = 90 + 162 * BK[p.pt as usize];
+                    (if mine { f } else { f + 81 }) + vsq
+                };
+                if n >= 40 {
+                    return Err("駒が多すぎる".into());
+                }
+                bps[n] = bp;
+                n += 1;
+            }
+        }
+    }
+    if ksq == u32::MAX {
+        return Err("玉がない".into());
+    }
+    for color in 0..2u8 {
+        for h in 0..7 {
+            let (fb, eb) = HAND_BASE[h];
+            let base = if color == persp { fb } else { eb };
+            for i in 0..pos.hands[color as usize][h] as u32 {
+                if n >= 40 {
+                    return Err("駒が多すぎる".into());
+                }
+                bps[n] = base + i;
+                n += 1;
+            }
+        }
+    }
+    let total = if k.with_king { 40 } else { 38 };
+    if n > total {
+        return Err("駒が多すぎる".into());
+    }
+    while n < total {
+        bps[n] = 0;
+        n += 1;
+    }
+    let mut kk = ksq;
+    let flip = k.mirror && ksq / 9 >= 5;
+    if flip {
+        kk = mir(ksq);
+    }
+    out.clear();
+    let nf = k.plane * k.nk;
+    for &b0 in &bps[..n] {
+        let mut b = b0;
+        if flip && b >= 90 {
+            b = 90 + ((b - 90) / 81) * 81 + mir((b - 90) % 81);
+        }
+        if k.merge && b >= E_KING {
+            b -= 81;
+        }
+        out.push(kk * k.plane + b);
+        if k.factor {
+            out.push(nf + b);
+        }
+    }
+    out.sort_unstable();
+    Ok(())
+}
+
+/// 玉の周りのブロック（区間 C）。視点座標で計算する。
+fn kingzone(pos: &Position, persp: u8, base: u32, out: &mut Vec<u32>) -> Result<(), String> {
+    let mut vb = [u8::MAX; 81];
+    let mut kings = [u32::MAX; 2];
+    for y in 0..9 {
+        for x in 0..9 {
+            if let Some(p) = pos.board[y][x] {
+                let (vy, vx) = if persp == 0 { (y, x) } else { (8 - y, 8 - x) };
+                let pc = p.pt + if p.color == persp { 0 } else { 14 };
+                vb[vy * 9 + vx] = pc;
+                if p.pt == 7 {
+                    kings[(p.color != persp) as usize] = (vy * 9 + vx) as u32;
+                }
+            }
+        }
+    }
+    for kk in 0..2 {
+        let k = kings[kk];
+        if k == u32::MAX {
+            return Err("玉がない".into());
+        }
+        let (ky, kx) = ((k / 9) as i32, (k % 9) as i32);
+        let mut o = 0u32;
+        for dy in -2..=2i32 {
+            for dx in -2..=2i32 {
+                if dy == 0 && dx == 0 {
+                    continue;
+                }
+                let (y, x) = (ky + dy, kx + dx);
+                let c = if !(0..9).contains(&y) || !(0..9).contains(&x) {
+                    28
+                } else {
+                    let v = vb[(y * 9 + x) as usize];
+                    if v == u8::MAX {
+                        o += 1;
+                        continue;
+                    }
+                    v as u32
+                };
+                out.push(base + kk as u32 * 696 + o * 29 + c);
+                o += 1;
+            }
+        }
+    }
+    Ok(())
+}
+
+/// 視点座標の玉のマス（y × 9 + x）。(手番側の玉（手番側の視点）, 相手の玉（相手の視点）)。
+pub fn king_squares(pos: &Position) -> Result<(i64, i64), String> {
+    let mut res = [-1i64; 2];
+    for y in 0..9 {
+        for x in 0..9 {
+            if let Some(p) = pos.board[y][x] {
+                if p.pt == 7 {
+                    let (vy, vx) = if p.color == 0 { (y, x) } else { (8 - y, 8 - x) };
+                    let i = (p.color != pos.stm) as usize;
+                    res[i] = (vy * 9 + vx) as i64;
+                }
+            }
+        }
+    }
+    if res[0] < 0 || res[1] < 0 {
+        return Err("玉がない".into());
+    }
+    Ok((res[0], res[1]))
+}
+
+/// どの版でも使える特徴の抽出。`pieces` は RayPair 用（使い回し）。
+pub fn extract(pos: &Position, pieces: &raypair::Pieces, persp: u8, version: u8, out: &mut Vec<u32>) -> Result<(), String> {
+    match version {
+        0 | 1 => raypair::features_from(pieces, persp, version, out),
+        12 | 13 => {
+            raypair::features_from(pieces, persp, version - 12, out)?;
+            kingzone(pos, persp, if version == 12 { 15000 } else { 115352 }, out)?;
+            out.sort_unstable();
+            Ok(())
+        }
+        _ => {
+            let k = kind(version).ok_or_else(|| format!("未知の version: {version}"))?;
+            halfk(pos, persp, k, out)
+        }
+    }
+}
