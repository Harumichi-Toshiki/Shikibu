+# ---------- やねうら王の nn.bin（§S11・§S12） ----------
+
+NNBIN_VERSION = 0x7AF32F16
+YO_FEATURES = {
+    "halfkp": ("HalfKP(Friend)", 0x5D69D5B8, 1548, 81),
+    "halfka1": ("HalfKA1(Friend)", 0x5F134CB8, 1710, 81),
+    "halfka2": ("HalfKA2(Friend)", 0x5F234CB8, 1629, 81),
